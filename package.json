{
  "name": "@consilioweb/payload-admin-ui-pro",
  "version": "0.7.0",
  "packageManager": "pnpm@11.25.0",
  "description": "Payload CMS 3 plugin — professional admin UI with 8 themes, dashboard builder, calendar/kanban/gallery views, command palette, notifications, keyboard shortcuts, collaboration presence, field enhancements, and activity audit trail",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    },
    "./views": {
      "import": {
        "types": "./dist/views.d.ts",
        "default": "./dist/views.js"
      }
    }
  },
  "bin": {
    "aup-audit-preferences": "./scripts/audit-dashboard-preferences.mjs"
  },
  "files": [
    "dist",
    "scripts",
    "!scripts/__tests__",
    "!scripts/dev",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "payload",
    "payload-cms",
    "payload-plugin",
    "admin-ui",
    "dashboard",
    "list-views",
    "command-palette",
    "branding",
    "kanban",
    "cards",
    "gallery",
    "activity-feed",
    "customization",
    "calendar",
    "notifications",
    "keyboard-shortcuts",
    "collaboration",
    "bulk-edit",
    "theme-marketplace",
    "dnd-kit",
    "nextjs",
    "react",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pOwn3d/payload-admin-ui-pro.git"
  },
  "homepage": "https://github.com/pOwn3d/payload-admin-ui-pro#readme",
  "bugs": {
    "url": "https://github.com/pOwn3d/payload-admin-ui-pro/issues"
  },
  "author": "ConsilioWEB <contact@consilioweb.fr> (https://consilioweb.fr)",
  "license": "MIT",
  "peerDependencies": {
    "@payloadcms/ui": "^3.79.1",
    "payload": "^3.79.1",
    "react": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "devDependencies": {
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/translations": "^3.88.0",
    "@payloadcms/ui": "^3.88.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "jsdom": "^30.0.1",
    "next": "^15.5.25",
    "payload": "^3.88.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2"
  }
}
